{
  "name": "@aios/verify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production verification harnesses (Phase 1-8). Hits real providers and real infra.",
  "scripts": {
    "phase1": "tsx src/phase1-claude.ts",
    "phase2": "tsx src/phase2-memory.ts",
    "phase3": "tsx src/phase3-router.ts",
    "phase4": "tsx src/phase4-tools.ts",
    "phase5": "tsx src/phase5-e2e.ts",
    "phase6": "tsx src/phase6-perf.ts",
    "phase7": "tsx src/phase7-security.ts",
    "phase8": "tsx src/phase8-deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings=0",
    "s2:claude": "tsx src/s2-claude.ts",
    "s2:memory": "node --expose-gc --import tsx src/s2-memory.ts",
    "s2:scenario": "tsx src/s2-scenario.ts",
    "s3:collab": "tsx src/s3-collab.ts",
    "s3:marketplace": "tsx src/s3-marketplace.ts",
    "s3:billing": "tsx src/s3-billing.ts",
    "s3:oauth": "tsx src/s3-oauth.ts",
    "s3:webui": "tsx src/s3-webui.ts",
    "s4:bigdata": "tsx src/s4-bigdata.ts",
    "s5:bigdata-api": "tsx src/s5-bigdata-api.ts",
    "s6:collab-multi": "tsx src/s6-collab-multi.ts",
    "eval": "tsx src/eval/run.ts"
  },
  "dependencies": {
    "@aios/ai": "workspace:*",
    "@aios/indexer": "workspace:*",
    "@aios/memory": "workspace:*",
    "@aios/plugin-host": "workspace:*",
    "@aios/sdk": "workspace:*",
    "@aios/shared": "workspace:*",
    "@aios/tools": "workspace:*",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "lib0": "^0.2.98",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.2"
  }
}

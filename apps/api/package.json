    "@aios/collab": "workspace:*",
    "@aios/indexer": "workspace:*",
    "@aios/memory": "workspace:*",
    "@aios/plugin-host": "workspace:*",
    "@aios/shared": "workspace:*",
    "@aios/tools": "workspace:*",
    "@duckdb/node-api": "^1.4.0-alpha.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "bullmq": "^5.12.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2"

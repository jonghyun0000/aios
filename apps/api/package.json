  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "node ../../scripts/build-node-app.mjs src/main.ts src/worker.ts src/bigdata-worker.ts",

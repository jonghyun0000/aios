{
  "name": "@aios/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": { "aios": "src/index.ts" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node ../../scripts/build-node-app.mjs src/index.ts",

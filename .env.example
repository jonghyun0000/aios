# --- Core infra ---
DATABASE_URL=postgres://aios:aios@localhost:5432/aios
REDIS_URL=redis://localhost:6379
# 컨테이너·Helm 기본값은 8787. 로컬 개발은 .env.local 에서 8790 을 쓴다(scripts/dev-up.sh).
PORT=8787

# --- Supabase (managed Postgres + Auth + Storage) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# --- LLM providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=xai-...

# --- Billing ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Sandbox ---
SANDBOX_IMAGE=aios-sandbox:latest

# --- Local inference (no provider key needed) ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 호환 API가 기본. Ollama 네이티브는 적재/입력/생성 시간을 제공한다.
LOCAL_LLM_PROTOCOL=openai
# 사용자 시작기(start-local.sh)는 ollama + 8192 컨텍스트로 실행한다.
# 시작기 컨텍스트만 변경하려면 실행 시 AIOS_LOCAL_CONTEXT를 지정한다.
# qwen3:8b — 실측 벤치에서 도구 호출·한국어 순도·지시 준수 모두 최우수.
# qwen2.5:7b-instruct 는 한국어 응답에 한자를 섞어 탈락했다(docs/14-offline-bigdata.md).
LOCAL_LLM_MODELS=qwen3:8b
LOCAL_EMBED_MODEL=bge-m3
LOCAL_LLM_CONTEXT=32768
# 동시성 상한 — 실측 근거는 packages/ai/src/providers/local.ts
LOCAL_CHAT_CONCURRENCY=2
LOCAL_EMBED_CONCURRENCY=4
# 모델 저장소는 반드시 T7 에 둔다. 없으면 Ollama 가 ~/.ollama 에 19GB 를 받는다.
OLLAMA_MODELS=/Volumes/T7/bigdata/ollama-models
# --- Big data (2.5억 행 공공통계, T7 에만 둔다) ---
BIGDATA_DB_PATH=/Volumes/T7/bigdata/bigdata.duckdb
# --- Memory ---
# 장기기억 중복 판정 임계값. 임베더마다 분포가 다르다 — bge-m3 실측값(docs/06-engines.md).
MEMORY_DEDUPE_THRESHOLD=0.97

# --- Local no-auth mode (development / single-user only) ---
# 1 로 켜면 127.0.0.1 에서 온 /v1/* 요청이 API 키 없이 owner 로 통과한다.
# NODE_ENV=production 과 함께 쓰면 부팅이 거부된다.
LOCAL_NO_AUTH=0
LOCAL_NO_AUTH_ORG_SLUG=local

{
  "name": "aios",
  "private": true,
  "version": "0.1.0",
  "description": "AIOS — AI Operating System: multi-LLM agentic coding platform (router, memory, tools, MCP, RAG, realtime collab)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "demo": "pnpm --filter @aios/demo dev --host 127.0.0.1",
    "build:demo": "pnpm --filter @aios/demo build",
    "doctor": "node scripts/doctor.mjs",
    "test:doctor": "node --test scripts/doctor.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "verify": "node scripts/verify-all.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "pg": "^8.12.0",
    "pnpm": "9.12.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  },
  "type": "module"
}
